{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "00000000000000000000000000000000",
  "name": "taski-pilot",
  "main": "src/adapters/worker/index.ts",
  "compatibility_date": "2026-11-12",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist/app",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/mcp", "/health", "/t/*", "/track/*", "/horizonte", "/horizonte/*"]
  },
  "secrets": {
    "required": ["TASKI_INSTALLATION_JSON", "TASKI_TEAM_ACCESS_CODE"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "taski-pilot",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "migrations"
    }
  ]
}
